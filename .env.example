# ============================================
# GovChain Backend Environment Configuration
# ============================================

# Server
PORT=5000
NODE_ENV=development
APP_NAME=GovChain
APP_VERSION=1.0.0

# Database (PostgreSQL)
# Local development or managed provider (e.g. Neon.tech, Supabase, Railway)
DATABASE_URL=postgresql://govchain_user:govchain_password@localhost:5432/govchain_db?schema=public

# Authentication & Security
# Generate a strong 32+ character random string for production
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=24h

# CORS
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# AI Integration (Optional — system safely falls back to deterministic rule-based engine)
AI_PROVIDER=
AI_API_KEY=
